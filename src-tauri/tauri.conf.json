{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Listen",
  "version": "0.1.0",
  "identifier": "com.easylisten.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Easy Listen",
        "width": 460,
        "height": 172,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
